rue},{"address_mode":"clamp_to_edge","binding":2,"mag_filter":"nearest","min_filter":"nearest","mip_filter":"not_mipmapped","normalized_coordinates":true},{"address_mode":"clamp_to_edge","binding":3,"mag_filter":"nearest","min_filter":"nearest","mip_filter":"not_mipmapped","normalized_coordinates":true},{"address_mode":"clamp_to_edge","binding":4,"mag_filter":"nearest","min_filter":"nearest","mip_filter":"not_mipmapped","normalized_coordinates":true},{"address_mode":"clamp_to_edge","binding":5,"mag_filter":"nearest","min_filter":"nearest","mip_filter":"not_mipmapped","normalized_coordinates":true},{"address_mode":"clamp_to_edge","binding":6,"mag_filter":"nearest","min_filter":"nearest","mip_filter":"not_mipmapped","normalized_coordinates":true},{"address_mode":"clamp_to_edge","binding":7,"mag_filter":"nearest","min_filter":"nearest","mip_filter":"not_mipmapped","normalized_coordinates":true}],"stage":"kernel","texture_arrays":[],"textures":[{"binding":0,"dimensions":[3,1,1],"format":"rgba32_float","initial_bytes_b64":"q6urq6urq6urq6urq6urq6urq6urq6urq6urq6urq6urq6urq6urq6urq6urq6ur","role":"output","texture_type":"d2"},{"binding":1,"dimensions":[1,1,1],"format":"rgba32_float","initial_bytes_b64":"q6urq6urq6urq6urq6urqw==","role":"output","texture_type":"d2"},{"binding":2,"bytes_b64":"AAAAAAAAAAAAAAAAAAAAAA==","dimensions":[1,1,1],"format":"rgba32_float","role":"input","texture_type":"d2"},{"binding":3,"bytes_b64":"AAAAAAAAAAAAAAAAAAAAAA==","dimensions":[1,1,1],"format":"rgba32_float","role":"input","texture_type":"d2"},{"binding":4,"bytes_b64":"AAAAAAAAAAAAAAAAAAAAAA==","dimensions":[1,1,1],"format":"rgba32_float","role":"input","texture_type":"d2"},{"binding":5,"bytes_b64":"AAAAAAAAAAAAAAAAAAAAAA==","dimensions":[1,1,1],"format":"rgba32_float","role":"input","texture_type":"d2"},{"binding":6,"bytes_b64":"AAAAAAAAAAAAAAAAAAAAAA==","dimensions":[1,1,1],"format":"rgba32_float","role":"input","texture_type":"d2"},{"binding":7,"bytes_b64":"AAAAAAAAAAAAAAAAAAAAAA==","dim