{"acceleration_structures":[],"air_sha256":"794d1a62c10e2b0644bffb242e1dba398bd05e64649473faf5a9239c4f01e8b2","argument_buffer_buffers":[],"argument_buffer_intersection_function_tables":[],"argument_buffer_textures":[],"authored_by":"claude:opus-5","buffers":[],"case_id":"5d8b6726348c90f2975b84dfb4d0f7095ea09dc1629ef29225da72878bb34408","compare":{"kind":"exact"},"device_buffer_arrays":[],"dispatch":{"grid":[2,2,1],"threads_per_threadgroup":[1,1,1]},"entry":"premultiply_texture_compute_gamma","execution_safety":"loop_free","function_constants":[],"intersection_function_tables":[],"kernel_stage_inputs":[],"name":"premultiply-gamma-through-short-texture-coordinates","output":{"binding":0,"dimensions":[2,2,1],"kind":"texture","origin":[0,0,0]},"rationale":"air.read_texture_2d.i16.v4f16 and air.write_texture_2d.i16.v4f16 address a texture through SHORT coordinates rather than the int coordinates every other authored texture case uses, and this entry drives both against one read_write binding in place, once per thread. It premultiplies alpha in gamma space, pow(alpha * pow(rgb, 2.2), 1/2.2). Every channel is authored 0.0 or 1.0 so both powers are exact on any implementation and the case measures the coordinate ABI rather than transcendental precision: the four texels (1,1,1,1), (0,0,0,1), (1,0,1,0) and (0,1,0,1) must become (1,1,1,1), (0,0,0,1), (0,0,0,0) and (0,1,0,1), four distinct values, so a coordinate that were widened or ordered wrongly would land a thread on another texel and change the captured 2x2 region.","render_targets":[],"samplers":[],"stage":"kernel","texture_arrays":[],"textures":[{"binding":0,"dimensions":[2,2,1],"format":"rgba16_float","initial_bytes_b64":"ADwAPAA8ADwAAAAAAAAAPAA8AAAAPAAAAAAAPAAAADw=","role":"in_out","texture_type":"d2"}],"threadgroup_memory":[],"vertex_inputs":[],"visible_function_references":[],"visible_function_tables":[]}
{"acceleration_structures":[],"air_sha256":"79a7d0d15031751e7dc4d80b2337989bdea2e60b88c51e97b575ec99d28bf13b","argument_buffer_buffers":[],"argument_buffer_intersection_function_tables":[],"argument_buffer_textures":[],"authored_by":"codex:gpt-5.6-sol","buffers":[{"binding":23,"bytes_b64":"AAAAAAAAAAAAAAAAAAAAAAEAAAABAAAAAQAAAAEAAAABAAAAAQAAAAEAAAABAAAAAQAAAAAAAAABAAAAAAAAAAEAAAAAAAAAAQAAAAAAAAA=","role":"input"},{"binding":29,"bytes_b64":"AQAAAAEAAAABAAAAAQAAAAEAAAABAAAAAQAAAAEAAAABAAAAAAAAAAAAAAAAAAAA","role":"input"}],"case_id":"e4f02844392b65707b16c49adae3ea48077bd9b34f7c931241aaa2461fc8bfe1","compare":{"kind":"exact"},"device_buffer_arrays":[{"binding":0,"elements":[{"index":0,"initial_bytes_b64":"q6urq6urq6urq6urq6urqw==","role":"in_out"}],"length":1}],"dispatch":{"grid":[1,1,1],"threads_per_threadgroup":[1,1,1]},"entry":"ndArrayIdentityComplexF32Transpose","execution_safety":"authored_bounded","function_constants":[{"bytes_b64":"AQAAAA==","index":122,"scalar_type":"u32"},{"bytes_b64":"5AABDg==","index":124,"scalar_type":"u32"}],"intersection_function_tables":[],"kernel_stage_inputs":[],"name":"linked-single-complex-transpose-write","output":{"binding":0,"element":0,"kind":"device_buffer_array_element","length":8,"offset":0},"rationale":"One dispatched invocation addresses one NDArray element. The reference-size and coordinate-mapping constants bound every dimension and stride to one; the linked prefix returns an exact nonzero value, the linked postfix writes it, and both callbacks are loop-free. Transpose variants use one initialized lane and the exact reflected dynamic threadgroup allocation.","render_targets":[],"samplers":[],"stage":"kernel","texture_arrays":[],"textures":[],"threadgroup_memory":[{"binding":0,"length":16}],"vertex_inputs":[],"visible_function_references":[{"function":"postfixPrimary_cf","module_sha256":"99f10a30205972c6013d57a0eaef7a30863da34a1fd4af19ab8f23e642da420b"},{"function":"prefixPrimary_cf","module_sha256":"bbdc4eaddef813c72ef6c71